params.total_cpus = Runtime.getRuntime().availableProcessors()
params.max_allowed_threads = Math.max(1, Math.floor(params.total_cpus * params.max_cpu_percent / 100.0).toInteger())

executor {
    name      = 'local'
    queueSize = 4
    cpus      = params.max_allowed_threads
}

process {
    executor       = 'local'
    clusterOptions = null
    errorStrategy  = 'retry'
    maxRetries     = 1

    cpus = { Math.max(1, Math.floor(params.total_cpus * 0.20).toInteger()) }

    withLabel: 'qc' {
        cpus     = { Math.max(1, Math.floor(params.total_cpus * 0.20).toInteger()) }
        maxForks = 3
    }

    withLabel: 'process_low' {
        cpus     = { Math.max(1, Math.floor(params.total_cpus * 0.15).toInteger()) }
        maxForks = 4
    }

    withLabel: 'process_medium' {
        cpus     = { Math.max(1, Math.floor(params.total_cpus * 0.30).toInteger()) }
        maxForks = 2
    }

    withLabel: 'process_high' {
        cpus     = { params.max_allowed_threads }
        maxForks = 1
    }
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/path/to/container_directory'
}