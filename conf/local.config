// Global CPU calculation for the local machine
def totalCpus = Runtime.runtime.availableProcessors()
def cpuMultiplier = params.max_cpu_percent / 100.0
def maxAllowedThreads = Math.max(1, (int)Math.floor(totalCpus * cpuMultiplier))

executor {
    name      = 'local'
    queueSize = 4
    cpus      = maxAllowedThreads
}

process {
    executor       = 'local'
    clusterOptions = null
    errorStrategy  = 'retry'
    maxRetries     = 1
            
    cpus = { Math.max(1, (int)Math.floor(totalCpus * 0.20)) }

    withLabel: 'qc' {
        cpus     = { Math.max(1, (int)Math.floor(totalCpus * 0.20)) }
        maxForks = 3
    }

    withLabel: 'process_low' {
        cpus     = { Math.max(1, (int)Math.floor(totalCpus * 0.15)) }
        maxForks = 4
    }

    withLabel: 'process_medium' {
        cpus     = { Math.max(1, (int)Math.floor(totalCpus * 0.30)) }
        maxForks = 2
    }    

    withLabel: 'process_high' {
        cpus     = { maxAllowedThreads }
        maxForks = 1
    }
}

singularity.enabled    = false
singularity.autoMounts = false

docker {
    enabled    = true
    autoMounts = true
}