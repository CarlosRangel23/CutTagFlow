process {
    withName: 'FASTQC' {
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }

    withName: 'TRIM' {
        container = 'quay.io/biocontainers/fastp:0.23.4--h5f740d0_0'
    }

    withName: 'BOWTIE2_ALIGN' {
        container = 'quay.io/biocontainers/bowtie2:2.5.1--h5f740d0_0' 
    }
}